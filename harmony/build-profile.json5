{
  "app": {
    "signingConfigs": [],
    "buildOption": {
      "sourceRoots": [
        "./ohos",
        "./platform/ohos/shims"
      ],
      "rnoh": {
        "jsBundleFile": "./entry/src/main/resources/rawfile/index.harmony.bundle",
        "codeCacheDir": "./codecache",
        "assetDest": "./entry/src/main/resources/rawfile",
        "entryRoot": "./ohos",
        "entryFileName": "index"
      }
    },
    "products": [
      {
        "name": "default",
        "signingConfig": "",
        "compatibleSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        { "name": "default", "applyTo": "default" }
      ]
    }
  ]
}
